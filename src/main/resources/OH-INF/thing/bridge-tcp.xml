<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="modbusext"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
 xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">
 <bridge-type id="tcp">
  <label>Modbus Ext TCP Slave</label>
  <description>TCP endpoint for Modbus Ext pollers.</description>
  <config-description>
   <parameter name="host" type="text" required="true"><label>IP Address or Hostname</label><default>localhost</default><context>network-address</context></parameter>
   <parameter name="port" type="integer" min="1" max="65535"><label>Port</label><default>502</default></parameter>
   <parameter name="id" type="integer"><label>Slave Id</label><default>1</default></parameter>
   <parameter name="rtuEncoded" type="boolean"><label>RTU Encoding</label><default>false</default></parameter>
   <parameter name="timeBetweenTransactionsMillis" type="integer" min="0" unit="ms"><label>Time Between Transactions</label><default>60</default></parameter>
   <parameter name="timeBetweenReconnectMillis" type="integer" min="0" unit="ms"><label>Time Between Reconnections</label><default>0</default><advanced>true</advanced></parameter>
   <parameter name="connectMaxTries" type="integer" min="1"><label>Maximum Connection Tries</label><default>1</default><advanced>true</advanced></parameter>
   <parameter name="afterConnectionDelayMillis" type="integer" min="0" unit="ms"><label>Connection Warm-up Time</label><default>0</default><advanced>true</advanced></parameter>
   <parameter name="reconnectAfterMillis" type="integer" min="0" unit="ms"><label>Reconnect Again After</label><default>0</default><advanced>true</advanced></parameter>
   <parameter name="connectTimeoutMillis" type="integer" min="0" unit="ms"><label>Connect Timeout</label><default>10000</default><advanced>true</advanced></parameter>
   <parameter name="receiveTimeoutMillis" type="integer" min="0" unit="ms"><label>Receive Timeout</label><default>3000</default><advanced>true</advanced></parameter>
  </config-description>
 </bridge-type>
</thing:thing-descriptions>
